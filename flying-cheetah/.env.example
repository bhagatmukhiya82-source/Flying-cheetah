# ==============================================================================
# FLYING CHEETAH LABS - SERVERLESS PLATFORM ENVIRONMENT VARIABLES (.env.example)
# Configure these variables in Vercel Project Settings > Environment Variables
# ==============================================================================

# 1. CORE AUTHENTICATION & JWT SECURITY (REQUIRED FOR PRODUCTION)
# Cryptographic secret for signing and verifying HS256 admin & client tokens.
# Generate via: openssl rand -base64 32
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters

# Seed password for default agency administrator account (flyingcheetah.agency@gmail.com)
INITIAL_ADMIN_PASSWORD=AdminPass2026!

# Primary notification recipient for inbound customer leads and demo bookings
FOUNDER_NOTIFY_EMAIL=flyingcheetah.agency@gmail.com

# 2. SUPABASE POSTGRESQL & REST API (REQUIRED FOR CLOUD PERSISTENCE)
# Supabase project URL and public anonymous API key
SUPABASE_URL=https://txqtkpxdyoatzdgkcsry.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here

# 3. NATIVE SMTPS TRANSACTIONAL MAILER (OPTIONAL / RECOMMENDED)
# Google Workspace or Gmail App Password (16 characters)
SMTP_USER=flyingcheetah.agency@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# 4. HYPERLOCAL LOGISTICS GATEWAY (OPTIONAL / SANDBOX MOCK BY DEFAULT)
# Borzo (WeFast) Business API v1.8 token. Leave blank or prefix with "MOCK" for sandbox simulation.
BORZO_AUTH_TOKEN=MOCK_BORZO_SANDBOX_TOKEN
BORZO_ENV=test

# 5. SECONDARY EMAIL FALLBACK PROVIDER (OPTIONAL)
RESEND_API_KEY=
FROM_EMAIL=Flying Cheetah <onboarding@resend.dev>

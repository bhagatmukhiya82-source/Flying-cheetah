# ==============================================================================
# FLYING CHEETAH LABS - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure your production credentials.
# Note: Leaving third-party keys with default "mock_*" values activates
# zero-cost local simulation mode for instant sandbox testing!
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Flying Cheetah Labs Backend"
ENVIRONMENT="development"                     # "development", "staging", "production"
PORT=8000
SECRET_KEY="super_secret_jwt_key_flying_cheetah_secure_random_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080             # 7 days token expiration

# Database Configuration (Supabase PostgreSQL 16)
# Default is SQLite for zero-config local testing: sqlite+aiosqlite:///./flying_cheetah.db
# For Supabase PostgreSQL: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="sqlite+aiosqlite:///./flying_cheetah.db"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Redis & Celery Distributed Task Queue
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Agency Notification Destination & Alerts
OFFICIAL_ADMIN_EMAIL="flyingcheetah.agency@gmail.com"
N8N_WEBHOOK_URL="https://automation.flyingcheetah.agency/webhook/leads-inbound"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="flyingcheetah.agency@gmail.com"
SMTP_PASSWORD="your-google-app-password"

# Meta Graph API v21.0 (WhatsApp Cloud API & Instagram Automation)
META_WHATSAPP_TOKEN="mock_meta_whatsapp_token_xyz"
META_PHONE_NUMBER_ID="mock_phone_number_id_9988"
META_APP_SECRET="mock_meta_app_secret_abc123"
META_WEBHOOK_VERIFY_TOKEN="flying_cheetah_webhook_verify_secret_2026"
INSTAGRAM_ACCESS_TOKEN="mock_ig_access_token_7788"
INSTAGRAM_ACCOUNT_ID="mock_ig_account_id_5544"

# AI Voice Agent (Twilio / Exotel SIP Trunk + Deepgram STT + ElevenLabs TTS)
TWILIO_ACCOUNT_SID="MOCK_TWILIO_ACCOUNT_SID_0000"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token_0000"
TWILIO_CALLER_NUMBER="+912269001122"
DEEPGRAM_API_KEY="mock_deepgram_key"
ELEVENLABS_API_KEY="mock_elevenlabs_key"

# Hyperlocal Courier APIs (18-Minute Mumbai Dispatch)
BORZO_AUTH_TOKEN="MOCK_BORZO_AUTH_TOKEN"
BORZO_API_URL="https://robotapitest.borzodelivery.com/api/business/2.0"
PORTER_API_KEY="MOCK_PORTER_API_KEY"
PORTER_API_URL="https://papi.porter.in/v1"

# Payment Gateways (Razorpay / Cashfree Dynamic UPI Intent)
RAZORPAY_KEY_ID="mock_rzp_key_test_123"
RAZORPAY_KEY_SECRET="mock_rzp_secret_456"
CASHFREE_APP_ID="mock_cashfree_app_id"
CASHFREE_SECRET_KEY="mock_cashfree_secret_key"

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS='["http://localhost:8080","http://127.0.0.1:8080","http://localhost:3000","https://flyingcheetah.agency"]'
